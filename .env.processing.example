QDRANT_URL=http://localhost:6333
COLLECTION_NAME=video_windows
DEVICE=cpu
WINDOW_SECONDS=10
STRIDE_SECONDS=5
BATCH_SIZE=8
WHISPER_MODEL=small
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLM_PROVIDER=local
# Hosted OpenAI-compatible Qwen API only; never commit a real key:
# VLM_PROVIDER=openai_compatible
# VLM_BASE_URL=https://provider.example/v1
# VLM_API_KEY=
# Official OpenAI Responses API vision provider (server-side only):
# VLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VLM_MODEL=gpt-4.1-mini
OPENAI_VLM_TIMEOUT_SECONDS=120
OPENAI_VLM_RETRIES=2
OPENAI_VLM_IMAGE_DETAIL=low
OPENAI_VLM_MAX_FRAMES=4
VLM_TIMEOUT_SECONDS=120
VLM_RETRIES=2
VLM_SELECTION_ENABLED=true
VLM_VISUAL_CHANGE_THRESHOLD=0.12
VLM_AUDIO_CHANGE_THRESHOLD=0.15
VLM_SPEECH_CHANGE_THRESHOLD=0.18
VLM_CHANGE_WEIGHT_VISUAL=0.55
VLM_CHANGE_WEIGHT_AUDIO=0.25
VLM_CHANGE_WEIGHT_SPEECH=0.20
VLM_COMBINED_CHANGE_THRESHOLD=0.13
VLM_MAX_GAP_WINDOWS=3
VLM_MAX_SELECTED_RATIO=0.60
VLM_CONTEXT_NEIGHBOURS=1
VLM_MIN_DIRECT_CONFIDENCE=0.50
