#gitignore
# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Env / secrets
.env
.env.*
*.key

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Claude Code local session state (not project source)
.claude/

# Model caches / large local artifacts, if ever pointed into the repo
*.pt
*.bin
*.safetensors

# Frontend (frontend/) - Node/Vite
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
