# Public launch mode. Keep false for unrestricted local/self-hosted development.
PUBLIC_LAUNCH_MODE=false
PUBLIC_DEMO_VISITOR_LIMIT=2
PUBLIC_DEMO_VISITOR_WINDOW_SECONDS=86400
PUBLIC_DEMO_IP_LIMIT=6
PUBLIC_DEMO_IP_WINDOW_SECONDS=86400
PUBLIC_DEMO_BURST_LIMIT=3
PUBLIC_DEMO_BURST_WINDOW_SECONDS=60
PUBLIC_DEMO_IDEMPOTENCY_SECONDS=86400
PUBLIC_DEMO_MAX_QUERY_CHARACTERS=1000
PUBLIC_DEMO_MAX_VIDEO_BYTES=26214400
PUBLIC_DEMO_MAX_SAMPLE_VIDEO_BYTES=104857600
PUBLIC_DEMO_MAX_IMAGE_BYTES=8388608
PUBLIC_DEMO_MAX_AUDIO_BYTES=10485760
PUBLIC_DEMO_MAX_REFERENCE_BYTES=26214400

# Server-only secrets. Generate independent random values of at least 32 bytes.
VISITOR_COOKIE_SECRET=
IP_HASH_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PUBLIC_DEMO_REDIS_PREFIX=aperture:public

# Only trust proxy headers when the deployment topology and proxy count are known.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1

# Public sample paths are server-only absolute paths or mounted-volume paths.
PUBLIC_SAMPLE_ANIMAL_PATH=
PUBLIC_SAMPLE_DOG_PATH=

# Developer routes are local by default and require both settings in public mode.
DEVELOPER_FEATURES_ENABLED=false
DEVELOPER_ADMIN_TOKEN=

# Exact browser origins, comma-separated. Avoid wildcards in production.
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGIN_REGEX=

# Server-side provider credentials; never expose these through VITE_ variables.
# Hosted deployments should prefer the JSON key pool. Keep the single-key
# variable only for local compatibility.
GEMINI_API_KEYS_JSON=[]
GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Frontend public configuration (Vercel project root: video_search_frontend).
VITE_SEARCH_API_URL=
VITE_SITE_URL=https://aperturevideo.up.railway.app
# Optional privacy-reviewed first-party analytics collector.
VITE_ANALYTICS_ENDPOINT=
VITE_GA_MEASUREMENT_ID=
VITE_PUBLIC_UPLOADS_ENABLED=false
